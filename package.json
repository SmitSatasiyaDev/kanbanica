{
  "name": "kanbanica",
  "version": "0.3.0",
  "description": "A modern, open-source project management tool for teams — workspaces, projects, boards, sprints, and tasks with real-time collaboration.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/stack256org/kanbanica#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stack256org/kanbanica.git"
  },
  "bugs": {
    "url": "https://github.com/stack256org/kanbanica/issues"
  },
  "keywords": [
    "project-management",
    "kanban",
    "task-management",
    "scrum",
    "sprints",
    "self-hosted",
    "open-source",
    "nextjs",
    "typescript",
    "postgresql",
    "drizzle-orm",
    "collaboration"
  ],
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "concurrently -n next,worker -c blue,yellow \"next dev --turbopack\" \"tsx --watch scripts/worker.ts\"",
    "dev:next": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:tokens": "./scripts/lint-tokens.sh",
    "format": "biome format --write",
    "docs:sync": "node scripts/sync-readme.mjs",
    "docs:check": "node scripts/sync-readme.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx --watch scripts/worker.ts",
    "worker:start": "tsx scripts/worker.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "db:migrate:prod": "tsx scripts/migrate.ts",
    "db:reset": "tsx db/reset.ts && pnpm db:migrate",
    "make:admin": "tsx scripts/make-admin.ts",
    "create:admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@floating-ui/dom": "^1.8.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.7.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/render": "^2.1.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-mention": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "files-sdk": "^2.2.4",
    "framer-motion": "^13.1.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "papaparse": "^5.7.0",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "react-hook-form": "^7.85.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tippy.js": "^6.3.7",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.47",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "7.8.3",
    "vitest": "^4.1.11"
  }
}
